---
interface Props {
  name: string;
  role: string;
  image: string;
}

const { name, role, image } = Astro.props;
---

<article class="professor-card">
  <div class="professor-card-image">
    <img
      src={image}
      alt={`Foto de ${name}`}
      loading="lazy"
      width="300"
      height="375"
    />
  </div>

  <div class="professor-card-body">
  <h3>{name}</h3> <br>
    <p>{role}</p>
  </div>
</article>