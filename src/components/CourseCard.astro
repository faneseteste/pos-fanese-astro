---
import type { Course } from '../data/courses';

interface Props {
  course: Course;
}

const { course } = Astro.props;
---

<article class:list={['course-card', `course-card--${course.accent}`]}>
  <a class="course-card-image" href={`/cursos/${course.slug}/`} aria-label={`Conheça ${course.name}`}>
    <img src={course.image} alt="" width="640" height="420" loading="lazy" />
    <span>{course.area}</span>
  </a>
  <div class="course-card-body">
    <p class="course-type">Pós-Graduação • {course.modality}</p>
    <h3><a href={`/cursos/${course.slug}/`}>{course.name}</a></h3>
    <p>{course.description}</p>
    <ul class="course-meta" aria-label="Informações resumidas">
      <li><strong>{course.workload}</strong><span>Carga horária</span></li>
      <li><strong>{course.modules}</strong><span>Formação</span></li>
      <li><strong>Nov. 2026</strong><span>Início previsto</span></li>
    </ul>
    <div class="course-actions">
      <a class="text-link" href={`/cursos/${course.slug}/`}>Conheça <span aria-hidden="true">→</span></a>
      <a class="button button--card" href={`/cursos/${course.slug}/`}>Inscreva-se</a>
    </div>
  </div>
</article>
