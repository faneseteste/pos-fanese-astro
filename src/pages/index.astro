---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CourseCard from '../components/CourseCard.astro';
import ProfessorCard from '../components/ProfessorCard.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

import { courses } from '../data/courses';
import { professors } from '../data/professors';
---

<BaseLayout>
  <Header />
  <main>
    <Hero />

    <section id="cursos" class="section courses-section">
      <div class="container">
        <div class="section-heading section-heading--center">
          <span class="eyebrow eyebrow--dark">Programas acadêmicos para quem lidera o futuro</span>
          <h2>Escolha a formação que acompanha o próximo passo da sua carreira</h2>
          <p>Dois cursos presenciais, atuais e orientados à aplicação prática do conhecimento.</p>
        </div>
        <div class="course-grid">
          {courses.map((course) => <CourseCard course={course} />)}
        </div>
      </div>
    </section>

   <section id="diferenciais" class="section faculty-highlight">
  <div class="container">

    <div class="course-section-heading course-section-heading--light">
      <div>
        <span class="eyebrow">Corpo Docente de Excelência</span>

        <h2>Aprenda com quem conecta teoria e prática</h2>

        <p>
          Conheça os especialistas e doutores que atuam no mercado
          e lideram nossas aulas.
        </p>
      </div>

      <div class="slider-controls">
        <button
          id="prof-prev"
          class="button button--outline-light button--small"
          aria-label="Professor anterior"
        style="cursor:pointer;">
          ←
        </button>

        <button
          id="prof-next"
          class="button button--gold button--small"
          aria-label="Próximo professor" style="cursor:pointer;"
        >
          →
        </button>
      </div>
    </div>

    <div class="professors-slider-container">
      <div class="professors-slider" id="professors-slider">
        {professors.map((professor) => (
          <ProfessorCard {...professor} />
        ))}
      </div>
    </div>

  </div>
</section>

    <FAQ />

    <section class="contact-band">
      <div class="container contact-band-inner">
        <div>
          <span class="eyebrow eyebrow--dark">Ainda está em dúvida?</span>
          <h2>Converse com a equipe da Pós-Graduação Fanese</h2>
        </div>
        <a class="button button--navy" href="tel:+557931420970">Fale com a Fanese</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  import '../scripts/professors-slider';
</script>