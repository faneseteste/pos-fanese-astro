---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CourseCard from '../components/CourseCard.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import { courses } from '../data/courses';
---

<BaseLayout>
  <Header />
  <main>
    <Hero />

    <section id="cursos" class="section courses-section">
      <div class="container">
        <div class="section-heading section-heading--center">
          <span class="eyebrow eyebrow--dark">Programas acadêmicos para quem lidera o futuro</span>
          <h2>Escolha a formação que acompanha o próximo passo da sua carreira</h2>
          <p>Dois cursos presenciais, atuais e orientados à aplicação prática do conhecimento.</p>
        </div>
        <div class="course-grid">
          {courses.map((course) => <CourseCard course={course} />)}
        </div>
      </div>
    </section>

    <section id="diferenciais" class="section faculty-highlight">
      <div class="container faculty-layout">
        <div class="faculty-image">
          <img src="/images/courses/docentes.jpg" alt="Profissionais reunidos em ambiente de aprendizagem" width="900" height="700" loading="lazy" />
        </div>
        <div class="faculty-copy">
          <span class="eyebrow">Aprenda com quem conecta teoria e prática</span>
          <h2>Conhecimento que acontece dentro e fora da sala de aula</h2>
          <p>Os programas foram desenhados para aproximar fundamentos sólidos, ferramentas atuais e desafios reais do mercado profissional.</p>
          <ul class="check-list">
            <li>Conteúdos organizados em módulos objetivos</li>
            <li>Encontros presenciais em finais de semana alternados</li>
            <li>Aplicação prática ao longo de toda a formação</li>
          </ul>
          <a class="button button--gold" href="#cursos">Explore os cursos</a>
        </div>
      </div>
    </section>

    <FAQ />

    <section class="contact-band">
      <div class="container contact-band-inner">
        <div>
          <span class="eyebrow eyebrow--dark">Ainda está em dúvida?</span>
          <h2>Converse com a equipe da Pós-Graduação Fanese</h2>
        </div>
        <a class="button button--navy" href="tel:+557931420970">Fale com a Fanese</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
